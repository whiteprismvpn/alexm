---
import { profile } from '../../data/profile.ru';
import '../../styles/portfolio.css';

const sections = [
  { id: 'top', label: 'Главная', number: '01' },
  { id: 'about', label: 'Обо мне', number: '02' },
  { id: 'experience', label: 'Опыт', number: '03' },
  { id: 'work', label: 'Проекты', number: '04' },
  { id: 'contact', label: 'Контакты', number: '05' }
];

const skills = [
  'Python',
  'FastAPI',
  'PostgreSQL',
  'SQL',
  'Telegram боты',
  'REST API',
  'Docker',
  'SQLAlchemy',
  'Аутентификация',
  'Webhooks',
  'Cloudflare'
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${profile.name} — ${profile.role}`} />
    <title>{profile.name} — {profile.role}</title>
  </head>

  <body style="cursor: none;">
    <div class="custom-cursor"></div>
    <div class="lang-switcher-simple">
      <a href="/" class="lang-link">en</a>
      <span class="lang-sep">/</span>
      <a href="/ru" class="lang-link active">RU</a>
    </div>

    <a class="contact-float" href="#contact" aria-label="Перейти к разделу контактов">
      Связаться <span>↗</span>
    </a>

    <nav class="side-nav" aria-label="Навигация по странице">
      {
        sections.map((section) => (
          <a href={`#${section.id}`} data-nav={section.id} aria-label={section.label}>
            <i></i>
            <span>{section.number} / {section.label}</span>
          </a>
        ))
      }
    </nav>

    <main>
      <section id="top" class="hero panel">
        <div class="hero-grid">
          <p class="kicker">{profile.location}</p>
          <p class="hero-index">01 / 05</p>

          <h1>{profile.role}</h1>

          <div class="hero-bottom">
            <p>{profile.intro}</p>
            <a class="round-link" href="#work" aria-label="Перейти к проектам">↓</a>
          </div>

          <div class="hero-shape shape-one"></div>
          <div class="hero-shape shape-two"></div>
        </div>
      </section>

      <section id="about" class="panel about">
        <div class="section-label"><span>02</span><p>Обо мне</p></div>
        <div class="about-layout">
          <div class="about-statement">
            <p>Бэкенд-системы для практических задач: от API-интеграций до надёжной автоматизации.</p>
          </div>

          <div class="stats">
            {
              profile.stats.map((stat) => (
                <div>
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="skill-summary" aria-label="Навыки">
          <div class="skill-group">
            <p>Работаю с</p>
            <div class="skill-list">{skills.map((skill) => <span>{skill}</span>)}</div>
          </div>
        </div>

        <div class="plain-skills" aria-label="Полный список навыков и языков">
          <p>Навыки</p>
          <p>{profile.skills.join(' · ')}</p>
          <p>Языки</p>
          <p>{profile.languages.join(' · ')}</p>
        </div>

        <div class="services">
          {
            profile.services.map((service, index) => (
              <div>
                <span>0{index + 1}</span>
                <p>{service}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section id="experience" class="panel experience">
        <div class="section-label">
          <span>03</span>
          <p>Опыт</p>
        </div>

        <div class="experience-list">
          {
            profile.experience.map((item) => (
              <article class="experience-item">
                <p class="period">{item.period}</p>

                <div>
                  <h3>{item.role}</h3>
                  <p class="company">{item.company}</p>
                </div>

                <p class="experience-text">{item.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="work" class="panel work">
        <div class="section-label">
          <span>04</span>
          <p>Избранные проекты</p>
        </div>

        <div class="project-list">
          {
            profile.projects.map((project, index) => (
              <article class={`project project-${index + 1}`}>
                <div class="project-top">
                  <span>{project.type}</span>
                  <span>0{index + 1}</span>
                </div>

                <div class="project-copy">
                  <h3>{project.title}</h3>
                  <p>{project.text}</p>
                  <strong>{project.metric}</strong>
                </div>

                <span class="project-arrow">↗</span>
              </article>
            ))
          }
        </div>
      </section>

      <section id="contact" class="panel contact">
        <div class="section-label">
          <span>05</span>
          <p>Контакты</p>
        </div>

        <div class="contact-content">
          <h2>
            Есть идея?
            <br />
            Давайте обсудим.
          </h2>

          <a class="email-link" href={`mailto:${profile.email}`}>
            {profile.email} <span>↗</span>
          </a>
        </div>

        <footer class="reveal">
          <div class="footer-cta">
            <p>Готовы масштабировать ваш бэкенд?</p>
            <div class="cta-group">
              <a href={`mailto:${profile.email}`} class="cta-button">Давайте работать вместе ↗</a>
              <a href="/resume.pdf" download="Alex_Makletsov_Resume.pdf" class="cta-button secondary">Скачать CV 📄</a>
            </div>
          </div>
          <div class="footer-bottom">
            <p>© {new Date().getFullYear()} {profile.name}</p>
            <div class="social-links">
              {
                profile.social.map((item) => (
                  <a href={item.url}>{item.label} ↗</a>
                ))
              }
            </div>
          </div>
        </footer>
      </section>
    </main>

    <style>
      .lang-switcher-simple {
        position: fixed;
        top: 20px;
        left: 20px;
        z-index: 100;
        font-size: 13px;
        font-weight: 500;
      }
      .lang-link {
        text-decoration: none;
        color: var(--muted);
        transition: color 0.2s ease;
      }
      .lang-link.active {
        color: var(--ink);
        font-weight: 700;
      }
      .lang-sep {
        margin: 0 4px;
        color: var(--muted);
      }
      .lang-link:hover {
        color: var(--ink);
      }
    </style>

    <script>
      function initNav() {
        const links = Array.from(document.querySelectorAll('[data-nav]'));
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((link) => {
                link.classList.toggle('active', link.dataset.nav === entry.target.id);
              });
              
              // Динамически меняем фон навигации в зависимости от секции
              const nav = document.querySelector('.side-nav');
              if (nav) {
                const bgColor = window.getComputedStyle(entry.target).backgroundColor;
                nav.style.backgroundColor = bgColor;
              }
            }
          });
        }, { threshold: 0.45 });
        document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));
      }
      
      function initCursor() {
        const cursor = document.querySelector('.custom-cursor');
        if (!cursor) return;

        document.addEventListener('mousemove', (e) => {
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
        });

        const hoverables = document.querySelectorAll('a, button, .round-link, .project');
        hoverables.forEach(el => {
          el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
          el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
        });
      }
      
      initNav();
      initCursor();
      document.addEventListener('astro:page-load', () => {
        initNav();
        initCursor();
      });
    </script>
  </body>
</html>
