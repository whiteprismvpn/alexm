
---
import { profile } from '../../data/profile.ru';
import '../../styles/portfolio.css';

const sections = [
  { id: 'top', label: 'Главная', number: '01' },
  { id: 'about', label: 'Обо мне', number: '02' },
  { id: 'experience', label: 'Опыт', number: '03' },
  { id: 'work', label: 'Проекты', number: '04' },
  { id: 'contact', label: 'Контакты', number: '05' }
];

const skills = [
  'Python',
  'FastAPI',
  'PostgreSQL',
  'SQL',
  'Telegram боты',
  'REST API',
  'Docker',
  'SQLAlchemy',
  'Аутентификация',
  'Webhooks',
  'Cloudflare'
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${profile.name} — ${profile.role}`} />
    <title>{profile.name} — {profile.role}</title>
  </head>

  <body style="cursor: none;">
    <div class="scroll-progress"></div>
    <div class="custom-cursor"></div>
    <div class="lang-switcher-simple">
      <a href="/" class="lang-link">en</a>
      <span class="lang-sep">/</span>
      <a href="/ru" class="lang-link active">RU</a>
    </div>

    <a class="contact-float" href="#contact" aria-label="Перейти к разделу контактов">
      Связаться <span>↗</span>
    </a>

    <nav class="side-nav" aria-label="Навигация по странице">
      {
        sections.map((section) => (
          <a href={`#${section.id}`} data-nav={section.id} aria-label={section.label}>
            <i></i>
            <span>{section.number} / {section.label}</span>
          </a>
        ))
      }
    </nav>

    <main>
      <section id="top" class="hero panel">
        <div class="hero-grid" style="opacity: 1 !important; visibility: visible !important; transform: none !important;">
          <p class="kicker">{profile.location}</p>
          <p class="hero-index">01 / 05</p>
          <h1>{profile.role}</h1>
          <div class="hero-bottom">
            <p>{profile.intro}</p>
            <a class="round-link" href="#work" aria-label="Перейти к проектам">↓</a>
          </div>
          <div class="hero-shape shape-one"></div>
          <div class="hero-shape shape-two"></div>
        </div>
      </section>

      <section id="about" class="panel about">
        <div class="section-label reveal"><span>02</span><p>Обо мне</p></div>
        <div class="about-layout reveal">
          <div class="about-statement">
            <p>Бэкенд-системы для практических задач: от API-интеграций до надёжной автоматизации.</p>
          </div>
          <div class="stats">
            {
              profile.stats.map((stat) => (
                <div>
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="skill-summary reveal" aria-label="Навыки">
          <div class="skill-group">
            <p>Работаю с</p>
            <div class="skill-list">{skills.map((skill) => <span>{skill}</span>)}</div>
          </div>
        </div>

        <div class="plain-skills reveal" aria-label="Полный список навыков и языков">
          <p>Навыки</p>
          <p>{profile.skills.join(' · ')}</p>
          <p>Языки</p>
          <p>{profile.languages.join(' · ')}</p>
        </div>

        <div class="services reveal">
          {
            profile.services.map((service, index) => (
              <div>
                <span>0{index + 1}</span>
                <p>{service}</p>
              </div>
            ))
          }
        </div>
        
        <div class="about-services-footer"></div>
      </section>

      <section id="experience" class="panel experience">
        <div class="section-label reveal">
          <span>03</span>
          <p>Опыт</p>
        </div>

        <div class="experience-list reveal">
          {
            profile.experience.map((item) => (
              <article class="experience-item">
                <p class="period">{item.period}</p>
                <div>
                  <h3>{item.role}</h3>
                  <p class="company">{item.company}</p>
                </div>
                <p class="experience-text">{item.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="work" class="panel work">
        <div class="section-label reveal">
          <span>04</span>
          <p>Избранные проекты</p>
        </div>

        <div class="project-list reveal">
          {
            profile.projects.map((project, index) => (
              <article class={`project project-${index + 1}`}>
                <div class="project-top">
                  <span>{project.type}</span><span>0{index + 1}</span>
                </div>
                <div class="project-copy">
                  <h3>{project.title}</h3>
                  <p>{project.text}</p>
                  <strong class="design-pill" style="cursor:pointer" data-project={project.title}>Архитектура ↗</strong>
                </div>
                <span class="project-arrow">↗</span>
              </article>
            ))
          }
        </div>
      </section>

      <section id="contact" class="panel contact">
        <div class="section-label reveal">
          <span>05</span>
          <p>Контакты</p>
        </div>

        <div class="contact-content reveal">
          <h2>
            Есть идея?
            <br />
            Давайте обсудим.
          </h2>
          <a class="email-link" href={`mailto:${profile.email}`}>
            {profile.email} <span>↗</span>
          </a>
        </div>

        <footer class="reveal">
          <div class="footer-cta">
            <p>Готовы масштабировать ваш бэкенд?</p>
            <div class="cta-group">
              <a href={`mailto:${profile.email}`} class="cta-button">Давайте работать вместе ↗</a>
            </div>
          </div>
          <div class="footer-bottom">
            <p>© {new Date().getFullYear()} {profile.name}</p>
            <div class="social-links">
              {
                profile.social.map((item) => (
                  <a href={item.url}>{item.label} ↗</a>
                ))
              }
            </div>
          </div>
        </footer>
      </section>
    </main>

    <div class="modal-overlay" id="modal-overlay">
      <div class="modal-content">
        <div class="modal-close" id="modal-close">×</div>
        <div id="modal-body"></div>
      </div>
    </div>

    <style>
      .lang-switcher-simple {
        position: fixed;
        top: 20px;
        left: 20px;
        z-index: 100;
        font-size: 13px;
        font-weight: 500;
      }
      .lang-link {
        text-decoration: none;
        color: var(--muted);
        transition: color 0.2s ease;
      }
      .lang-link.active {
        color: var(--ink);
        font-weight: 700;
      }
      .lang-sep {
        margin: 0 4px;
        color: var(--muted);
      }
      .lang-link:hover {
        color: var(--ink);
      }
    </style>

    <script>
      import { initGridBackground, initTooltips } from '../../scripts/visual-effects.js';

      function initNav() {
        const links = Array.from(document.querySelectorAll('[data-nav]'));
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((link) => {
                link.classList.toggle('active', link.dataset.nav === entry.target.id);
              });
            }
          });
        }, { threshold: 0.45 });
        document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));
      }

      function initCursor() {
        const cursor = document.querySelector('.custom-cursor');
        if (!cursor) return;
        document.addEventListener('mousemove', (e) => {
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
        });
        const hoverables = document.querySelectorAll('a, button, .round-link, .project, .design-pill');
        hoverables.forEach(el => {
          el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
          el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
        });
      }

      function initReveal() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }

      function initProgress() {
        window.addEventListener('scroll', () => {
          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          const bar = document.querySelector('.scroll-progress');
          if(bar) bar.style.width = scrolled + '%';
        });
      }

      function initTerminal() {
        const input = document.getElementById('terminal-input');
        const body = document.getElementById('terminal-body');
        if(!input || !body) return;
        const commands = {
          'help': 'Доступные команды: <span style="color:#50fa7b">skills</span>, <span style="color:#50fa7b">contact</span>, <span style="color:#50fa7b">clear</span>, <span style="color:#50fa7b">about</span>',
          'skills': 'Стек: Python, FastAPI, PostgreSQL, Docker и Cloudflare Workers.',
          'contact': 'Email: alex@example.com | GitHub: @whiteprismvpn',
          'about': 'Бэкенд-инженер, специализируюсь на высокопроизводительных API и надежной инфраструктуре.',
          'clear': 'CLEAR'
        };
        async function typeText(text, isCommand = false) {
          const line = document.createElement('div');
          line.className = 'terminal-line';
          if (isCommand) {
            line.innerHTML = '<span class="terminal-prompt">alexm@MacBook-Pro ~ %</span> ';
          }
          body.appendChild(line);
          
          if (text === 'CLEAR') {
            body.innerHTML = '';
            return;
          }

          const span = document.createElement('span');
          line.appendChild(span);
          
          for (let i = 0; i < text.length; i++) {
            span.innerHTML += text.charAt(i);
            body.scrollTop = body.scrollHeight;
            await new Promise(r => setTimeout(r, 20));
          }
        }
        input.addEventListener('keydown', async (e) => {
          if (e.key === 'Enter') {
            const val = input.value.toLowerCase().trim();
            const originalValue = input.value;
            input.value = '';
            
            await typeText(originalValue, true);
            
            if (val === 'clear') {
              body.innerHTML = '';
            } else if (commands[val]) {
              await typeText(commands[val]);
            } else if (val !== '') {
              await typeText('<span style="color:#ff5f56">Команда не найдена: ' + val + '</span>');
            }
          }
        });
      }

      function initModals() {
        const overlay = document.getElementById('modal-overlay');
        const close = document.getElementById('modal-close');
        const body = document.getElementById('modal-body');
        if(!overlay || !close || !body) return;
        const projectData = {
          'Project Title': 'Архитектура: [Клиент] -> [FastAPI] -> [PostgreSQL]. Использован Redis для кэширования. JWT для авторизации.',
        };
        document.querySelectorAll('.design-pill').forEach(pill => {
          pill.addEventListener('click', () => {
            const title = pill.dataset.project;
            body.innerHTML = '<h2 style="margin-top:0">' + title + '</h2><p>' + (projectData[title] || 'Системная архитектура: Высокодоступный бэкенд с масштабируемыми микросервисами и оптимизированными запросами к БД.') + '</p>';
            overlay.classList.add('active');
          });
        });
        close.addEventListener('click', () => overlay.classList.remove('active'));
        overlay.addEventListener('click', (e) => { if(e.target === overlay) overlay.classList.remove('active'); });
      }

      function initVisuals() {
        initGridBackground();
        initTooltips();
      }

      initNav(); initCursor(); initReveal(); initProgress(); initTerminal(); initModals();
      initVisuals();

      document.addEventListener('astro:page-load', () => {
        initNav(); initCursor(); initReveal(); initProgress(); initTerminal(); initModals();
        initVisuals();
      });
    </script>
  </body>
</html>
