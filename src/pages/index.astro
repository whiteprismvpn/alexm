---
import { profile } from '../data/profile';
import '../styles/portfolio.css';
const sections = [{ id: 'top', label: 'Начало', number: '01' }, { id: 'about', label: 'Обо мне', number: '02' }, { id: 'experience', label: 'Опыт', number: '03' }, { id: 'work', label: 'Проекты', number: '04' }, { id: 'contact', label: 'Контакты', number: '05' }];
---
<!doctype html><html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={`${profile.name} — ${profile.role}`} /><title>{profile.name} — {profile.role}</title></head><body><header class="site-header"><a class="monogram" href="#top" aria-label="На главную">{profile.shortName}</a><p class="header-status"><span></span>{profile.availability}</p><a class="header-mail" href={`mailto:${profile.email}`}>Написать ↗</a></header><nav class="side-nav" aria-label="Навигация по странице">{sections.map((section) => <a href={`#${section.id}`} data-nav={section.id} aria-label={section.label}><i></i><span>{section.number} / {section.label}</span></a>)}</nav><main><section id="top" class="hero panel"><div class="hero-grid"><p class="kicker">{profile.location}</p><p class="hero-index">01 / 05</p><h1>{profile.role}</h1><div class="hero-bottom"><p>{profile.intro}</p><a class="round-link" href="#work" aria-label="Перейти к проектам">↓</a></div></div><div class="hero-shape shape-one"></div><div class="hero-shape shape-two"></div></section><section id="about" class="panel about"><div class="section-label"><span>02</span><p>Обо мне</p></div><div class="about-layout"><h2>{profile.about}</h2><div class="stats">{profile.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></div><div class="services">{profile.services.map((service, index) => <div><span>0{index + 1}</span><p>{service}</p></div>)}</div></section><section id="experience" class="panel experience"><div class="section-label"><span>03</span><p>Опыт</p></div><div class="experience-list">{profile.experience.map((item) => <article class="experience-item"><p class="period">{item.period}</p><div><h3>{item.role}</h3><p class="company">{item.company}</p></div><p class="experience-text">{item.text}</p></article>)}</div></section><section id="work" class="panel work"><div class="section-label"><span>04</span><p>Выбранные проекты</p></div><div class="project-list">{profile.projects.map((project, index) => <article class={`project project-${index + 1}`}><div class="project-top"><span>{project.type}</span><span>0{index + 1}</span></div><div class="project-copy"><h3>{project.title}</h3><p>{project.text}</p><strong>{project.metric}</strong></div><span class="project-arrow">↗</span></article>)}</div></section><section id="contact" class="panel contact"><div class="section-label"><span>05</span><p>Контакты</p></div><div class="contact-content"><h2>Есть идея?<br />Давайте обсудим.</h2><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <span>↗</span></a></div><footer><p>© {new Date().getFullYear()} {profile.name}</p><div>{profile.social.map((item) => <a href={item.url}>{item.label} ↗</a>)}</div></footer></section></main><script>const links = Array.from(document.querySelectorAll('[data-nav]')); const observer = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) links.forEach((link) => link.classList.toggle('active', link.dataset.nav === entry.target.id)); }); }, { threshold: 0.45 }); document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));</script></body></html>