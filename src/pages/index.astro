---
import { profile } from '../data/profile';
import '../styles/resume.css';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{profile.name} — {profile.role}</title></head><body><main><section class="hero"><header><a class="logo" href="/">{profile.name}.</a><a class="menu" href="#about">Menu</a></header><div class="hero-copy"><p class="eyebrow">{profile.location}</p><h1>I’m a<br />{profile.role}</h1><a class="resume-link" href="#about">View résumé</a></div><div class="orb"></div></section><nav class="mobile-nav"><a href="#about">About</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#portfolio">Portfolio</a><a href="#contact">Contact</a></nav><section id="about" class="section about"><p class="eyebrow">/ About</p><h2>{profile.about}</h2></section><section id="experience" class="section"><p class="eyebrow">/ Experience</p>{profile.experience.map((item) => <article class="row"><div><h3>{item.role}</h3><p>{item.company}</p></div><div><p>{item.period}</p><p>{item.text}</p></div></article>)}</section><section id="skills" class="section"><p class="eyebrow">/ Skills</p><div class="chips">{profile.services.map((service) => <span>{service}</span>)}</div></section><section id="portfolio" class="section"><p class="eyebrow">/ Portfolio</p><div class="projects">{profile.projects.map((project) => <article class="project"><h3>{project.title}</h3><p>{project.text}</p><span>{project.metric}</span></article>)}</div></section><footer id="contact"><h2>Let’s work together.</h2><a href={`mailto:${profile.email}`}>{profile.email}</a><div>{profile.social.map((item) => <a href={item.url}>{item.label}</a>)}</div><small>© {new Date().getFullYear()} {profile.name}. All rights reserved.</small></footer></main></body></html>