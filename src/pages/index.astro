---
import { profile } from '../data/profile';
import '../styles/portfolio.css';

const sections = [
  { id: 'top', label: 'Home', number: '01' },
  { id: 'about', label: 'About', number: '02' },
  { id: 'experience', label: 'Experience', number: '03' },
  { id: 'work', label: 'Projects', number: '04' },
  { id: 'contact', label: 'Contact', number: '05' }
];

const skills = [
  'Python',
  'FastAPI',
  'PostgreSQL',
  'SQL',
  'Telegram Bots',
  'REST APIs',
  'Docker',
  'SQLAlchemy',
  'Authentication',
  'Webhooks',
  'Cloudflare'
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${profile.name} — ${profile.role}`} />
    <title>{`${profile.name} — ${profile.role}`}</title>
  </head>

  <body style="cursor: none;">
    <div class="scroll-progress"></div>
    <div class="custom-cursor"></div>
    <div class="lang-switcher-simple">
      <a href="/" class="lang-link active">EN</a>
      <span class="lang-sep">/</span>
      <a href="/ru" class="lang-link">ru</a>
    </div>

    <a class="contact-float" href="#contact" aria-label="Go to contact section">
      Get in touch <span>↗</span>
    </a>

    <nav class="side-nav" aria-label="Page navigation">
      {
        sections.map((section) => (
          <a href={`#${section.id}`} data-nav={section.id} aria-label={section.label}>
            <i></i>
            <span>{section.number} / {section.label}</span>
          </a>
        ))
      }
    </nav>

    <main id="main-content">
      <section id="top" class="hero panel">
        <div class="hero-grid reveal">
          <p class="kicker">{profile.location}</p>
          <p class="hero-index">01 / 05</p>
          <h1>{profile.role}</h1>
          <div class="hero-bottom">
            <p>{profile.intro}</p>
            <a class="round-link" href="#work" aria-label="Go to projects">↓</a>
          </div>
          <div class="hero-shape shape-one"></div>
          <div class="hero-shape shape-two"></div>
        </div>
      </section>

      <section id="about" class="panel about">
        <div class="section-label reveal"><span>02</span><p>About</p></div>
        <div class="about-layout reveal">
          <div class="about-statement">
            <p>Backend systems for practical workflows, from API integrations to reliable automations.</p>
          </div>
          <div class="stats">
            {profile.stats.map((stat) => (
              <div><strong>{stat.value}</strong><span>{stat.label}</span></div>
            ))}
          </div>
        </div>

        <div class="skill-summary reveal" aria-label="Skills">
          <div class="skill-group">
            <p>Building with</p>
            <div class="skill-list">{skills.map((skill) => <span>{skill}</span>)}</div>
          </div>
        </div>

        <div class="plain-skills reveal" aria-label="Full skills and languages">
          <p>Skills</p>
          <p>{profile.skills.join(' · ')}</p>
          <p>Languages</p>
          <p>{profile.languages.join(' · ')}</p>
        </div>

        <div class="services reveal">
          {profile.services.map((service, index) => (
            <div><span>0{index + 1}</span><p>{service}</p></div>
          ))}
        </div>

        <div class="about-services-footer"></div>
      </section>

      <section id="experience" class="panel experience">
        <div class="section-label reveal"><span>03</span><p>Experience</p></div>
        <div class="experience-list reveal">
          {profile.experience.map((item) => (
            <article class="experience-item">
              <p class="period">{item.period}</p>
              <div><h3>{item.role}</h3><p class="company">{item.company}</p></div>
              <p class="experience-text">{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="work" class="panel work">
        <div class="section-label reveal"><span>04</span><p>Selected Projects</p></div>
        <div class="project-list reveal">
          {profile.projects.map((project, index) => (
            <article class={`project project-${index + 1}`}>
              <div class="project-top">
                <span>{project.type}</span><span>0{index + 1}</span>
              </div>
              <div class="project-copy">
                <h3>{project.title}</h3>
                <p>{project.text}</p>
              </div>
              <span class="project-arrow">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="panel contact">
        <div class="section-label reveal"><span>05</span><p>Contact</p></div>
        <div class="contact-content reveal">
          <h2>Have an idea?<br />Let’s talk.</h2>
          <a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <span>↗</span></a>
        </div>
        <footer class="reveal">
          <div class="footer-cta">
            <p>Ready to scale your backend?</p>
            <div class="cta-group">
              <a href={`mailto:${profile.email}`} class="cta-button">Let's work together ↗</a>
            </div>
          </div>
          <div class="footer-bottom">
            <p>© {new Date().getFullYear()} {profile.name}</p>
            <div class="social-links">
              {profile.social.map((item) => (<a href={item.url}>{item.label} ↗</a>))}
            </div>
          </div>
        </footer>
      </section>
    </main>

    <div class="modal-overlay" id="modal-overlay">
      <div class="modal-content">
        <div class="modal-close" id="modal-close">×</div>
        <div id="modal-body"></div>
      </div>
    </div>

    <style>
      .lang-switcher-simple {position:fixed;top:20px;left:20px;z-index:100;font-size:13px;font-weight:500}
      .lang-link {text-decoration:none;color:var(--muted);transition:color 0.2s ease}
      .lang-link.active {color:var(--ink);font-weight:700}
      .lang-sep {margin:0 4px;color:var(--muted)}
      .lang-link:hover {color:var(--ink)}
    </style>

    <script>
      function initDataFlow() {
        const main = document.getElementById('main-content');
        if (!main) return;
        const canvas = document.createElement('canvas');
        canvas.id = 'data-flow-canvas';
        canvas.style.position = 'fixed';
        canvas.style.top = '0';
        canvas.style.left = '0';
        canvas.style.width = '100%';
        canvas.style.height = '100%';
        canvas.style.pointerEvents = 'none';
        canvas.style.zIndex = '-1';
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        let width, height;
        function resize() {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();
        const particles = [];
        class Particle {
          constructor() { this.reset(); }
          reset() {
            this.x = Math.random() * width;
            this.y = Math.random() * height;
            this.vx = (Math.random() - 0.5) * 0.5;
            this.vy = (Math.random() - 0.5) * 0.5;
            this.life = Math.random() * 100 + 50;
            this.opacity = 0;
          }
          update() {
            this.x += this.vx;
            this.y += this.vy;
            this.life--;
            this.opacity = Math.sin((this.life / 100) * Math.PI) * 0.2;
            if (this.life <= 0) this.reset();
          }
          draw() {
            ctx.beginPath();
            ctx.arc(this.x, this.y, 1, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(215, 255, 62, ${this.opacity})`;
            ctx.fill();
          }
        }
        for (let i = 0; i < 50; i++) particles.push(new Particle());
        function animate() {
          ctx.clearRect(0, 0, width, height);
          particles.forEach(p => { p.update(); p.draw(); });
          requestAnimationFrame(animate);
        }
        animate();
      }

      function initNav() {
        const links = Array.from(document.querySelectorAll('[data-nav]'));
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((link) => {
                link.classList.toggle('active', link.dataset.nav === entry.target.id);
              });
              const nav = document.querySelector('.side-nav');
              if (nav) {
                const bgColor = window.getComputedStyle(entry.target).backgroundColor;
                nav.style.backgroundColor = bgColor;
              }
            }
          });
        }, { threshold: 0.45 });
        document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));
      }

      function initCursor() {
        const cursor = document.querySelector('.custom-cursor');
        if (!cursor) return;
        document.addEventListener('mousemove', (e) => {
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
        });
        const hoverables = document.querySelectorAll('a, button, .round-link, .project, .design-pill');
        hoverables.forEach(el => {
          el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
          el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
        });
      }

      function initReveal() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }

      function initProgress() {
        window.addEventListener('scroll', () => {
          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          const bar = document.querySelector('.scroll-progress');
          if(bar) bar.style.width = scrolled + '%';
        });
      }

      function initModals() {
        const overlay = document.getElementById('modal-overlay');
        const close = document.getElementById('modal-close');
        const body = document.getElementById('modal-body');
        
        const projectArchitectures = {
          'Project Title': {
            nodes: [
              { id: 'client', label: 'Client', x: 50, y: 100, desc: 'Frontend application / Mobile app' },
              { id: 'api', label: 'FastAPI', x: 200, y: 100, desc: 'High-performance Python API' },
              { id: 'db', label: 'PostgreSQL', x: 350, y: 150, desc: 'Relational data storage' },
              { id: 'cache', label: 'Redis', x: 350, y: 50, desc: 'Distributed caching' },
            ],
            edges: [
              { from: 'client', to: 'api' },
              { from: 'api', to: 'db' },
              { from: 'api', to: 'cache' },
            ]
          }
        };

        function renderArchitecture(projTitle) {
          const arch = projectArchitectures[projTitle];
          if (!arch) return `<p>System architecture: High-availability backend with scalable microservices and optimized DB queries.</p>`;
          let svg = `<svg viewBox="0 0 450 250" style="width:100%; height:auto; max-width:500px; margin: 20px auto; display:block; background:#1c1c1c; border-radius:12px; padding:20px; box-sizing:border-box; color:#fff; font-family:monospace">`;
          arch.edges.forEach(edge => {
            const fromNode = arch.nodes.find(n => n.id === edge.from);
            const toNode = arch.nodes.find(n => n.id === edge.to);
            svg += `<line x1="${fromNode.x}" y1="${fromNode.y}" x2="${toNode.x}" y2="${toNode.y}" stroke="#444" stroke-width="2" marker-end="url(#arrowhead)" />`;
          });
          arch.nodes.forEach(node => {
            svg += `<g class="arch-node" data-desc="${node.desc}" style="cursor:pointer">
                      <rect x="${node.x - 40}" y="${node.y - 20}" width="80" height="40" rx="5" fill="#333" stroke="#555" stroke-width="1" />
                      <text x="${node.x}" y="${node.y + 5}" text-anchor="middle" fill="#fff" font-size="12px">${node.label}</text>
                    </g>`;
          });
          svg += `<defs><marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#444" /></marker></defs></svg>`;
          return `<div class="arch-container">${svg}<div id="arch-desc" style="text-align:center; min-height:40px; font-size:14px; color:var(--muted); margin-top:10px;">Hover over a component to see details</div></div>`;
        }

        document.querySelectorAll('.design-pill').forEach(pill => {
          pill.addEventListener('click', (e) => {
            const title = pill.dataset.project;
            const popup = document.createElement('div');
            popup.className = 'design-popup';
            popup.innerHTML = `
              <div class="popup-header">
                <span>Architecture: ${title}</span>
                <span class="popup-close" style="cursor:pointer">×</span>
              </div>
              <div class="popup-body">${renderArchitecture(title)}</div>
            `;
            const rect = pill.getBoundingClientRect();
            popup.style.position = 'fixed';
            popup.style.top = `${rect.bottom + window.scrollY + 10}px`;
            popup.style.left = `${rect.left + window.scrollX}px`;
            popup.style.zIndex = '1000';
            document.body.appendChild(popup);

            const nodes = popup.querySelectorAll('.arch-node');
            const descBox = popup.querySelector('#arch-desc');
            nodes.forEach(node => {
              node.addEventListener('mouseenter', () => {
                descBox.innerText = node.getAttribute('data-desc');
                descBox.style.color = 'var(--acid)';
                node.querySelector('rect').setAttribute('stroke', 'var(--acid)');
                node.querySelector('rect').setAttribute('fill', '#444');
              });
              node.addEventListener('mouseleave', () => {
                descBox.innerText = 'Hover over a component to see details';
                descBox.style.color = 'var(--muted)';
                node.querySelector('rect').setAttribute('stroke', '#555');
                node.querySelector('rect').setAttribute('fill', '#333');
              });
            });

            popup.querySelector('.popup-close').addEventListener('click', () => popup.remove());
            const closePopup = (event) => {
              if (!popup.contains(event.target) && event.target !== pill) {
                popup.remove();
                document.removeEventListener('mousedown', closePopup);
              }
            };
            document.addEventListener('mousedown', closePopup);
          });
        });

        if(overlay && close) {
          close.addEventListener('click', () => overlay.classList.remove('active'));
          overlay.addEventListener('click', (e) => { if(e.target === overlay) overlay.classList.remove('active'); });
        }
      }

      initNav(); initCursor(); initReveal(); initProgress(); initModals(); initDataFlow();
      document.addEventListener('astro:page-load', () => {
        initNav(); initCursor(); initReveal(); initProgress(); initModals(); initDataFlow();
      });
    </script>
  </body>
</html>
